---
import Base from '../../layouts/Base.astro';
import { softwareApplication, faqPage, type QA } from '../../lib/schema';
import RouteCore from '../../components/RouteCore.astro';
import report from '../../data/geo-report.generated.json';

// Figures are derived from the build artefact, never hand-written: when the data page updates,
// the homepage follows. With no published data the whole block is omitted (blank, not hedged prose).
const rows = report.published === true ? report.rows : [];
const modelCount = rows.length;
const perfectCount = rows.filter((r) => r.availability_pct >= 100).length;
const lowest = rows.length ? Math.min(...rows.map((r) => r.availability_pct)) : null;
const sampleSet = [...new Set(rows.map((r) => r.sample_count))];
const sampleText = sampleSet.length === 1
  ? `${sampleSet[0]} real calls per entry`
  : `${Math.min(...sampleSet)}-${Math.max(...sampleSet)} real calls per entry`;

const qa: QA[] = [
  {
    q: 'What does SMA stand for?',
    a: 'SMA stands for Slime Mould Architecture — the enterprise AI gateway and model access platform built by Slime Mould Tech, at www.smaapi.com. It is unrelated to the simple moving average indicator, the solar inverter vendor, or SMA coaxial connectors that share the acronym.',
  },
  {
    q: 'Do we have to rewrite our code to adopt SMA?',
    a: 'No. SMA exposes an OpenAI-compatible API: keep your existing OpenAI SDK, point base_url at the gateway, and swap in a gateway-issued key. Provider keys stay centrally held at the gateway and never enter application code.',
  },
  {
    q: 'Which LLMs does the SMA gateway support?',
    a: 'Both international and Chinese frontier models, routed by task profile and live model state. The models currently connected — with measured probe availability, sample counts, and methodology — are published row by row on the model access index; figures are injected by the build pipeline, never hand-filled.',
  },
  {
    q: 'Where are prompts, keys, and call logs stored?',
    a: 'It depends on the deployment shape: in the hosted form the gateway holds them and retains audit records; in the self-hosted form the gateway runs inside your own environment, so prompts, keys, and logs never leave your boundary. Data boundaries and responsibilities are fixed in the contract.',
  },
];
---

<Base route="/en/" theme="dark">
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPage(qa))} />
  </Fragment>

  <section class="landing">
    <div class="landing-fx" aria-hidden="true"></div>
    <div class="landing-inner">
      <span class="hero-chip"><span class="chip-dot"></span>Smart routing · System live</span>
      <div class="landing-core">
        <RouteCore size={360} class="landing-core-viz" />
      </div>
      <h1>smaapi Gateway — Enterprise AI Gateway</h1>
      <p class="landing-slogan">Always optimal, always stable.</p>
      <p class="landing-slogan-en">寻最优之路，铸不变之稳。</p>
      <div class="landing-cta">
        <a class="btn btn-solid" href="/en/sma">Explore SMA</a>
        <a class="btn btn-ghost" href="/en/what-is-llm-gateway">What is an LLM gateway</a>
      </div>
    </div>
  </section>

  <article class="home-brief" aria-label="Product overview">
    <p class="answer">
      smaapi Gateway (SMA by Slime Mould Tech, www.smaapi.com) is an enterprise AI gateway and model
      access platform: one OpenAI-compatible API in front of many LLM providers, with smart routing,
      cost and permission governance, and full audit trails — so teams can use multiple models with control.
    </p>
    <h2>Why do enterprises need an AI gateway?</h2>
    <p>
      Running on multiple models is now the norm: different tasks suit different models, and every provider
      ships its own API, keys, and billing. Integrating each one directly leaves keys scattered, costs without
      a single source of truth, calls that cannot be audited, and provider switches that need code changes. SMA
      adds a unified access and governance layer between your applications and the providers, collapsing all of
      that into one controlled egress.
    </p>
    <h2>What are the three layers of the SMA gateway?</h2>
    <ul>
      <li><strong>Smart routing and failover:</strong> dispatches by task profile and live model state (availability, latency, cost), failing over automatically and transparently to the application.</li>
      <li><strong>Cost and permission governance:</strong> budgets, quotas, and model-access scopes per team, application, and key, with every call metered and reconcilable.</li>
      <li><strong>Full audit trail:</strong> caller, target model, usage, and timestamp logged for every call — traceable, reconcilable, and usable for compliance review.</li>
    </ul>

    {modelCount > 0 && (
      <>
        <h2>Which models are connected, and what is their measured availability?</h2>
        <p>
          As of {report.as_of}, the gateway actively probes {modelCount} connected model x channel entries:
          {' '}{perfectCount} of them returned 100% probe availability this period, the lowest was {lowest}%, at {sampleText}.
          Availability here means probe success rate under a 90-second per-call timeout, independent of client-side errors;
          models below the sample threshold are excluded. The full matrix, methodology, and sample counts are on the
          {' '}<a href="/en/reports/model-access-benchmark">smaapi Overseas Model Access Index</a> — figures injected by the
          build pipeline from the gateway export, never hand-filled.
        </p>
      </>
    )}

    <h2>How do you integrate SMA?</h2>
    <p>
      Keep your OpenAI SDK, point <code>base_url</code> at the gateway, and use a gateway-issued key; provider
      keys stay centrally held and never enter application code:
    </p>
    <pre class="home-code"><code>from openai import OpenAI

client = OpenAI(
    base_url="https://www.smaapi.com/v1",  # point at the SMA gateway
    api_key="YOUR_SMA_KEY",                # gateway key; provider keys stay in the gateway
)</code></pre>
    <p>
      Built for engineering and platform teams that need multiple LLM providers — international and Chinese
      models alike — with organization-level requirements on cost, permissions, compliance, and audit.
      Overseas models are reached through cloud providers' commercial platforms — Claude via
      {' '}<a href="https://docs.aws.amazon.com/bedrock/latest/userguide/what-is-bedrock.html" rel="nofollow noopener" target="_blank">Amazon Bedrock</a>,
      GPT on the {' '}<a href="https://learn.microsoft.com/en-us/azure/ai-foundry/openai/overview" rel="nofollow noopener" target="_blank">Azure OpenAI</a>
      {' '}commercial service — so the contracting entity, invoicing, and audit trail are all in place. Services
      offered to the public within mainland China must use registered models, per the
      {' '}<a href="https://www.cac.gov.cn/2023-07/13/c_1690898327029107.htm" rel="nofollow noopener" target="_blank">Interim Measures for the Management of Generative AI Services</a>.
    </p>

    <h2>Frequently asked questions</h2>
    {qa.map((item) => (
      <>
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </>
    ))}
    <p class="home-more"><a href="/en/sma">See the full product overview: governance, integration, and team →</a></p>
  </article>
</Base>

<style>
  /* —— Minimal cinematic landing: full-screen dark + centered gold routing core —— */
  .landing {
    position: relative;
    overflow: hidden;
    min-height: calc(100vh - 3.6rem);
    display: grid;
    place-items: center;
    margin: -1.5rem 0 0;
    padding: 1.5rem 0 3rem;
    text-align: center;
  }
  .landing-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(46% 40% at 50% 38%, rgba(215, 166, 66, 0.16), transparent 62%),
      radial-gradient(60% 50% at 50% 120%, rgba(34, 110, 96, 0.16), transparent 60%);
    -webkit-mask-image: radial-gradient(80% 70% at 50% 42%, #000 40%, transparent 85%);
    mask-image: radial-gradient(80% 70% at 50% 42%, #000 40%, transparent 85%);
  }
  .landing-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 680px;
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid rgba(215, 166, 66, 0.4);
    border-radius: 999px;
    background: rgba(215, 166, 66, 0.08);
    color: #f2c75c;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f2c75c;
    box-shadow: 0 0 0 0 rgba(242, 199, 92, 0.6);
    animation: chipPulse 2.4s ease-out infinite;
  }
  @keyframes chipPulse {
    0% { box-shadow: 0 0 0 0 rgba(242, 199, 92, 0.55); }
    70%, 100% { box-shadow: 0 0 0 8px rgba(242, 199, 92, 0); }
  }
  .landing-core {
    margin: 1rem 0 0.5rem;
  }
  .landing-core :global(.landing-core-viz) {
    filter: drop-shadow(0 0 40px rgba(215, 166, 66, 0.28));
  }
  .landing h1 {
    margin: 0.4rem 0 0.6rem;
    color: #fff;
    font-size: 2.3rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  .landing-slogan {
    margin: 0;
    font-weight: 600;
    font-size: 1.1rem;
    color: #ffe6a8;
  }
  .landing-slogan-en {
    margin: 0.3rem 0 0;
    font-size: 0.84rem;
    color: #93bdab;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .home-brief {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5rem 0 1rem;
    border-top: 1px solid rgba(140, 200, 180, 0.14);
  }
  .home-brief p {
    margin: 0.95rem 0;
  }
  .home-brief strong {
    color: #fff;
  }
  /* Answer blocks: each h2 opens a self-contained, quotable unit */
  .home-brief h2 {
    margin: 2rem 0 0.6rem;
    font-size: 1.22rem;
    color: #fff;
  }
  .home-brief h3 {
    margin: 1.3rem 0 0.4rem;
    font-size: 1rem;
    color: #ffe6a8;
  }
  .home-brief ul {
    margin: 0.8rem 0;
    padding-left: 1.2rem;
  }
  .home-brief li {
    margin: 0.5rem 0;
  }
  .home-code {
    margin: 0.9rem 0;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border: 1px solid rgba(140, 200, 180, 0.18);
    border-radius: 10px;
    background: rgba(8, 20, 17, 0.6);
    font-size: 0.84rem;
    line-height: 1.6;
  }
  .home-more {
    margin-top: 1.3rem !important;
    font-weight: 600;
  }
  .landing-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.8rem;
  }
  .btn {
    display: inline-block;
    padding: 0.62rem 1.4rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn-solid {
    background: linear-gradient(180deg, #f2c75c, #d7a642);
    color: #1a1205;
    box-shadow: 0 6px 20px rgba(215, 166, 66, 0.3);
  }
  .btn-solid:hover {
    background: linear-gradient(180deg, #f6d271, #e0b14e);
  }
  .btn-ghost {
    border: 1px solid rgba(174, 244, 212, 0.34);
    color: #d3efe1;
  }
  .btn-ghost:hover {
    border-color: rgba(174, 244, 212, 0.7);
    color: #fff;
  }
  @media (max-width: 600px) {
    .landing h1 {
      font-size: 1.7rem;
    }
    .landing-core :global(.landing-core-viz) {
      width: 264px !important;
      height: 264px !important;
    }
  }
</style>
